# Database URL (Default: local SQLite for zero-config startup; switch to PostgreSQL when Docker is running)
# PostgreSQL URL: postgresql://medadmin:medpassword123@localhost:5432/medical_records_db
DATABASE_URL=sqlite:///./medical_records.db

# JWT Security
JWT_SECRET_KEY=btech-project-2501730022-2501730270-super-secret-jwt-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# AI Engine Configuration
# Options: "grounded_hybrid" ( works out-of-the-box offline + optional LLM), "gemini", "ollama"
AI_PROVIDER=grounded_hybrid
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
ALLOW_EXTERNAL_PHI=false
